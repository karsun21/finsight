# Secrets
.env
*.pem
*.key

# Financial data — NEVER commit
inbox/*/*
!inbox/*/.gitkeep
data/
*.pdf
*.csv
*.xlsx
*.xls
*.qfx
*.ofx
*.qbo
# ...except synthetic test fixtures and the demo dataset, which contain no real
# data. Both are invented amounts and dates against real merchant brands, so the
# categorization rules have something to match. Keep it that way.
!backend/tests/fixtures/**
!demo/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Models cache (sentence-transformers)
.cache/
models/

# Node
node_modules/
dist/
.vite/

# OS / editor
.DS_Store
.idea/
.vscode/
