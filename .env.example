# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Database ---
POSTGRES_USER=finsight
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=finsight
POSTGRES_PORT=5433
# Used by the API container (host is the compose service name)
DATABASE_URL=postgresql+psycopg://finsight:change_me_locally@db:5432/finsight

# --- Anthropic ---
# Create a separate API key at console.anthropic.com (NOT your Claude Pro login).
# Set a monthly spend limit in the console before you start.
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (see docs/DATA-SOURCES.md §Cost)
CHAT_MODEL=claude-sonnet-5
CLASSIFY_MODEL=claude-haiku-4-5

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Ingestion ---
INBOX_DIR=/inbox
